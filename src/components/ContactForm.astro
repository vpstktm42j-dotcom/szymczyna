---
import { site } from '../data/site';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---
<form class="form glass-light" data-contact-form data-endpoint={endpoint} data-email={site.contact.email} method="post" action={endpoint || undefined}>
  <div class="row">
    <label>Name<input name="name" type="text" placeholder="Your name" required autocomplete="name" /></label>
    <label>Email<input name="email" type="email" placeholder="you@company.com" required autocomplete="email" /></label>
  </div>
  <label>Subject<input name="subject" type="text" placeholder="Let me know how i can help you" /></label>
  <label>Message<textarea name="message" rows="4" placeholder="Project inquiry, freelance collaboration, or just saying hi..." required></textarea></label>
  <button class="send" type="submit">Send message</button>
  <p class="status" data-form-status role="status" aria-live="polite"></p>
</form>

<style>
  .form { display: grid; gap: 24px; padding: 36px 24px 16px; font-family: var(--font-sans); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding-inline: 12px; }
  .form > label { padding-inline: 12px; }
  label { display: grid; gap: 8px; font-size: 12px; font-weight: 500; color: var(--ink); }
  input, textarea {
    width: 100%;
    font: 400 14px/1.4 var(--font-sans);
    color: var(--ink);
    padding: 10px 12px;
    border: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 0 0 1px rgba(15, 24, 38, 0.06);
    transition: box-shadow 0.2s ease, background 0.2s ease;
  }
  textarea { resize: vertical; min-height: 100px; }
  .form > label:has(textarea) { padding-inline: 0; }
  input:focus, textarea:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 1.5px var(--accent); }
  ::placeholder { color: #9aa1ad; }
  .send {
    height: 48px; border: 0; border-radius: 32px; cursor: pointer;
    background: var(--accent); color: #fff;
    font: 500 14px/1 var(--font-sans);
    transition: transform 0.4s var(--ease-out), background-color 0.2s ease;
  }
  .send:hover { background: #4f93f8; transform: scale(1.02); }
  .send:disabled { opacity: 0.6; cursor: progress; }
  .status { min-height: 1.2em; font-size: 13px; text-align: center; color: var(--text); }
  .status[data-state='ok'] { color: #15803d; }
  .status[data-state='error'] { color: #b91c1c; }
  @media (max-width: 600px) {
    .row { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
