---
import { site } from '../data/site';
import { assets } from '../data/assets';
const { contact } = site;
---
<ul class="media">
  <li>
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path fill="#4285f4" d="M2 6.5v11A1.5 1.5 0 0 0 3.5 19H6v-8.2l-4-3z"/><path fill="#34a853" d="M18 19h2.5a1.5 1.5 0 0 0 1.5-1.5v-11l-4 2.8z"/><path fill="#fbbc04" d="M18 5.3v5.5l4-3V6.5c0-1.6-1.8-2.5-3.1-1.6z"/><path fill="#ea4335" d="M6 10.8V5.3l6 4.5 6-4.5v5.5l-6 4.5z"/><path fill="#c5221f" d="M2 6.5v1.3l4 3V5.3l-.9-.7A1.9 1.9 0 0 0 2 6.5z"/></svg>
    </span>
    <span class="desc">
      <strong>Email</strong>
      <button type="button" class="copy" data-copy={contact.email} aria-label={`Copy ${contact.email}`}>
        <span data-copy-default>{contact.email}</span>
        <span data-copy-done hidden>Copied!</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </button>
    </span>
  </li>
  <li>
    <span class="icon icon--wa" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path fill="#fff" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm0 16.4a7.4 7.4 0 0 1-3.8-1l-.3-.2-2.7.7.7-2.6-.2-.3A7.4 7.4 0 1 1 12 19.4zm4.1-5.5c-.2-.1-1.3-.7-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6 6 0 0 1-3-2.6c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.4a.8.8 0 0 0-.6.3 2.5 2.5 0 0 0-.8 1.9 4.4 4.4 0 0 0 .9 2.3 10 10 0 0 0 3.8 3.4c1.4.6 2 .6 2.7.5.4-.1 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1l-.4-.4z"/></svg>
    </span>
    <a class="desc" href={contact.whatsapp} target="_blank" rel="noopener">
      <strong>WhatsApp</strong>
      <span>Chat with me <span aria-hidden="true">↗</span></span>
    </a>
  </li>
  <li>
    <span class="icon" aria-hidden="true"><img src={assets.iconLinkedin} alt="" width="24" height="24" /></span>
    <a class="desc" href={contact.linkedin} target="_blank" rel="noopener">
      <strong>LinkedIn</strong>
      <span>Connect with me <span aria-hidden="true">↗</span></span>
    </a>
  </li>
</ul>

<style>
  .media { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  li { display: flex; align-items: center; gap: 8px; min-height: 40px; }
  .icon {
    flex: 0 0 36px; height: 36px;
    display: grid; place-items: center;
    border-radius: 50%; background: #fff;
  }
  .icon svg, .icon img { width: 20px; height: 20px; }
  .icon img { width: 24px; height: 24px; }
  .icon--wa { background: #25d366; }
  .desc { display: grid; text-decoration: none; font-size: 14px; line-height: 1.4; color: var(--text); }
  .desc strong { font-size: 12px; font-weight: 500; color: var(--ink); }
  a.desc:hover span { color: var(--accent); }
  .copy {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 0; border: 0; background: none; cursor: pointer;
    font-size: 14px; color: var(--text); text-align: left;
  }
  .copy svg { width: 16px; height: 16px; flex: none; }
  .copy:hover { color: var(--accent); }
  [data-copy-done] { color: var(--accent); }
</style>
