---
interface Props { value: string; text: string }
const { value, text } = Astro.props;
---
<article class="cta card">
  <h3>{value}</h3>
  <p class="text">{text}</p>
  <p class="label">Want to know why?</p>
  <a class="btn btn--ghost" href="/contact">Get in touch <span aria-hidden="true">↓</span></a>
</article>

<style>
  .cta { padding: 1.5rem; font-family: var(--font-display); display: flex; flex-direction: column; gap: 0.75rem; }
  h3 { font-size: 1.5rem; color: var(--ink-strong); }
  p { margin: 0; }
  .text { color: var(--text-soft); }
  .label { font-size: 0.9rem; font-weight: 600; margin-top: auto; }
  .btn { align-self: flex-start; }
</style>
