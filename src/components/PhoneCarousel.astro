---
interface Props { screens: string[]; label: string }
const { screens, label } = Astro.props;
---
<div class="phones" role="region" aria-label={`${label} screens`} tabindex="0">
  {screens.map((src, i) => (
    <figure class="phone">
      <img src={src} alt={`${label} — screen ${i + 1}`} width="412" height="896" loading="lazy" />
    </figure>
  ))}
</div>

<style>
  .phones {
    display: flex; gap: 1.75rem;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 1rem calc(50vw - 140px) 2rem;
    margin-inline: calc(50% - 50vw);
    scrollbar-width: none;
  }
  .phones::-webkit-scrollbar { display: none; }
  .phone {
    flex: 0 0 260px; margin: 0;
    scroll-snap-align: center;
    padding: 10px;
    border-radius: 42px;
    background: #111;
    box-shadow: 0 25px 40px -20px rgba(15, 24, 38, 0.45);
  }
  .phone img { width: 100%; height: auto; border-radius: 32px; }
</style>
