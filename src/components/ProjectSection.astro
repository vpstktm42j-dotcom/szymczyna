---
import type { Project } from '../data/projects';
import { assets } from '../data/assets';
import StatCard from './StatCard.astro';
import CtaCard from './CtaCard.astro';
import PhoneCarousel from './PhoneCarousel.astro';
import LaptopMockup from './LaptopMockup.astro';

interface Props { project: Project }
const { project } = Astro.props;
---
<section id={project.id} class:list={['project', `project--${project.device}`]}>
  <div class="container">
    <h2>{project.number}. {project.title}.</h2>

    {project.award && (
      <div class="award">
        <img src={assets.laurelLeft} alt="" width="56" height="69" />
        <div>
          <img class="agh" src={assets.logoAgh} alt="AGH University" width="26" height="41" />
          <p class="award__title">{project.award.title}</p>
          <p class="award__sub">{project.award.subtitle}</p>
        </div>
        <img src={assets.laurelRight} alt="" width="56" height="69" />
      </div>
    )}

    <p class="summary">{project.summary}</p>

    {project.device === 'phone'
      ? <PhoneCarousel screens={project.screens} label={project.title} />
      : <LaptopMockup screen={project.screens[0]} label={project.title} />}

    <div class="stats">
      {project.stats.map((stat) => <StatCard stat={stat} />)}
      <CtaCard value={project.closing.value} text={project.closing.text} />
    </div>
  </div>
</section>

<style>
  .project { padding-block: 5rem; }
  .project--phone { background: linear-gradient(180deg, var(--mint), var(--bg)); }
  h2 {
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 700;
  }
  .award {
    display: flex; justify-content: center; align-items: center; gap: 0.5rem;
    margin-top: 1.5rem; text-align: center;
  }
  .award .agh { margin-inline: auto; }
  .award__title { margin: 0.25rem 0 0; font-size: 0.8rem; font-weight: 700; color: var(--ink); text-transform: uppercase; }
  .award__sub { margin: 0; font: 300 0.75rem var(--font-display); }
  .summary { max-width: 72ch; margin: 1.75rem auto 3rem; text-align: center; color: var(--ink); }
  .stats {
    display: grid; gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
</style>
