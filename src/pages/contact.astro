---
import Base from '../layouts/Base.astro';
import ContactMedia from '../components/ContactMedia.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---
<Base title={`Contact — ${site.name}`}>
  <section class="contact page">
    <div class="info">
      <h1>Contact Me</h1>
      <p class="intro">{site.contact.intro}</p>
      <ContactMedia />
    </div>
    <ContactForm />
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 305px) minmax(0, 477px);
    justify-content: center;
    align-items: start;
    gap: 96px;
    padding-block: 96px;
  }
  .info { display: grid; gap: 32px; padding-top: 24px; }
  h1 { font: 700 30px/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink-strong); }
  .intro { font-size: 16px; line-height: 1.5; color: var(--text-soft); }
  @media (max-width: 809px) {
    .contact { grid-template-columns: minmax(0, 1fr); gap: 48px; padding-block: 48px; }
  }
</style>
