---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MountainGuide from '../components/MountainGuide.astro';
import TestExecute from '../components/TestExecute.astro';
---
<Base scrollTop>
  <Hero />
  <div id="projects">
    <h2 class="selected page">// SELECTED WORK</h2>
    <MountainGuide />
    <TestExecute />
  </div>
</Base>

<style>
  .selected {
    padding-bottom: 36px;
    font: 700 30px/1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  @media (max-width: 809px) { .selected { font-size: 24px; } }
</style>
